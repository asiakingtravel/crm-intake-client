{
    "name": "asiakingtravel/crm-intake-client",
    "description": "Laravel adapter gửi lead form từ website AsiaKingTravel sang CRM intake API (DA-121).",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.0.2",
        "guzzlehttp/guzzle": "^7.2",
        "laravel/framework": "^9.0|^10.0|^11.0|^12.0",
        "symfony/uid": "^5.4|^6.0|^7.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.5",
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "AsiaKingTravel\\CrmIntake\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AsiaKingTravel\\CrmIntake\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AsiaKingTravel\\CrmIntake\\CrmIntakeServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
